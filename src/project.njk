---
pagination:
  data: site.projects
  size: 1
  alias: p
permalink: "/{{ p.slug }}/index.html"
---
{%- set s = site -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ p.title }} – {{ s.brandName }} Design</title>
<meta name="description" content="{{ p.summary }}">
<meta property="og:title" content="{{ p.title }} – {{ s.brandName }} Design">
<meta property="og:description" content="{{ p.summary }}">
<meta property="og:type" content="website">
<meta property="og:url" content="https://swiftprimedesign.com/{{ p.slug }}/">
<meta property="og:image" content="https://swiftprimedesign.com{{ p.cover }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0B0B0C">
<link rel="canonical" href="https://swiftprimedesign.com/{{ p.slug }}/">
<link rel="icon" type="image/png" href="/images/logo-dark.png">
<link rel="preload" href="/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/site.css">
</head>
<body>
<div class="page">
  <header class="site-header">
    <nav class="wrap nav" aria-label="Main">
      <a href="/" class="brand">
        <img src="/images/logo-white.png" alt="" width="26" height="26">
        <span class="brand-name">{{ s.brandName }}</span>
        <span class="mono brand-tag">{{ s.brandTagline }}</span>
      </a>
      <div class="nav-links">
        <a href="/#work">Work</a>
        <a class="btn nav-cta" href="/#contact" data-track="cta-nav"><span class="dot" aria-hidden="true" style="background:#FF5A1F"></span>Start a brief</a>
      </div>
    </nav>
  </header>

  <main class="wrap case-page">
    <p class="mono case-page-tag">{{ p.tag }}</p>
    <h1 class="case-page-title">{{ p.title }}</h1>
    <p class="case-page-summary">{{ p.summary }}</p>
    <dl class="mono facts">
      <dt>Type</dt><dd>{{ p.type }}</dd>
      <dt>Client</dt><dd>{{ p.client }}</dd>
      <dt>Year</dt><dd>{{ p.year }}</dd>
    </dl>

    <img class="case-page-cover" src="{{ p.cover }}" alt="{{ p.coverAlt }}" width="1800" height="1350">

    <div class="case-cols case-page-cols">
      <div><span class="mono">Problem</span><p>{{ p.problem }}</p></div>
      <div><span class="mono">Process</span><p>{{ p.process }}</p></div>
      <div><span class="mono">Result</span><p>{{ p.result }}</p></div>
    </div>

    <div class="case-page-imgs">
    {%- for img in p.images %}
      <img src="{{ img.src }}" alt="{{ img.alt }}" loading="lazy" width="1800" height="1350">
    {%- endfor %}
    </div>

    <div class="card case-page-cta">
      <h2>{{ s.contact.question }} <span class="hl-plain">{{ s.contact.highlight }}</span></h2>
      <a class="btn btn-light" href="/#contact" data-track="cta-case-{{ p.slug }}">{{ s.hero.button }}</a>
      <p class="mono"><a href="/#work">← See all work</a></p>
    </div>
  </main>

  <footer class="wrap" style="padding-bottom:48px">
    <p class="mono copy">© {{ year }} {{ s.brandName }} Design. All rights reserved. · <a href="/privacy/">Privacy</a></p>
  </footer>
</div>
<script src="/js/site.js" defer></script>
{%- if s.analytics.cloudflareToken %}
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ s.analytics.cloudflareToken }}"}'></script>
{%- endif %}
</body>
</html>
